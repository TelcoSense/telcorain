# global settings
[time]
step=10
output_step=10
start=2024-09-19T03:30:00
end=2024-09-19T12:30:00

[setting]
repetition_interval=600
sleep_interval=30
output_json_info=True
write_influx_intensities=False
dry_as_nan=False

[logging]
init_level=INFO

[directories]
logs=./logs
outputs=outputs
outputs_web=outputs_web
outputs_raw=outputs_raw
outputs_json=outputs_json
outputs_sum=outputs_sum
outputs_sum_json=outputs_sum_json
clean_web=False
clean_raw=False
save_web=True
save_raw=False

[hour_sum]
enabled=False
window_minutes=60
write_influx_sum=False

# database settings
[influx2]
url=
org=
token=
timeout=50000
verify_ssl=False
bucket_influx_data=realtime_cbl
bucket_out_cml=telcorain_output

[mariadb]
address=
port=
user=
pass=
timeout=10000
db_metadata=cml_metadata
db_output=telcorain_output

# computation settings
[cml]
min_length=0.5
max_length=100
exclude_cmls=True
exclude_cmls_path=cml_info/invalid_cmls.csv

[cml_filter]
enabled=False
run_realtime_at_start=True
realtime_interval_runs=1000
realtime_quality_window=
min_endpoint_coverage=0.5
min_channel_coverage=0.5
min_valid_samples=12
minimum_good_channels=1
rsl_min_dbm=-120
rsl_max_dbm=120
effective_rsl_min_dbm=-70
tsl_min_dbm=-20
tsl_max_dbm=40
trsl_min_db=0
trsl_max_db=99
min_trsl_p05_p95_range_db=0.02
require_tsl=False

[cml_filter:1s10]
rsl_min_dbm=-96.586
rsl_max_dbm=-33.552
tsl_min_dbm=-5.000
tsl_max_dbm=4.460
trsl_min_db=31.552
trsl_max_db=91.898
min_trsl_p05_p95_range_db=0.234

[cml_filter:ceragon_ip_10]
rsl_min_dbm=-100.200
rsl_max_dbm=-35.915
tsl_min_dbm=-3.000
tsl_max_dbm=16.304
trsl_min_db=33.915
trsl_max_db=69.948
min_trsl_p05_p95_range_db=0.363

[cml_filter:ceragon_ip_20]
rsl_min_dbm=-102.000
rsl_max_dbm=-40.027
tsl_min_dbm=-3.000
tsl_max_dbm=19.000
trsl_min_db=42.077
trsl_max_db=85.961
min_trsl_p05_p95_range_db=0.398

[cml_filter:ceragon_ip_50]
rsl_min_dbm=-54.000
rsl_max_dbm=-23.000
tsl_min_dbm=-5.000
tsl_max_dbm=22.000
trsl_min_db=32.380
trsl_max_db=64.877
min_trsl_p05_p95_range_db=0.131

[cml_filter:summit]
rsl_min_dbm=-88.150
rsl_max_dbm=53.052
tsl_min_dbm=-9.000
tsl_max_dbm=18.770
trsl_min_db=-50.065
trsl_max_db=87.705
min_trsl_p05_p95_range_db=0.271

[cml_filter:summit_bt]
rsl_min_dbm=-80.489
rsl_max_dbm=54.915
tsl_min_dbm=-8.080
tsl_max_dbm=23.000
trsl_min_db=-53.310
trsl_max_db=77.615
min_trsl_p05_p95_range_db=0.250

[realtime]
realtime_timewindow=1d
retention_window=7d
metadata_refresh_interval_runs=60 ; set 0 to disable periodic MariaDB metadata reload

[historic]
compensate_historic=True

[data_source]
mode=influx ; influx | pycomlink_example | pycomlink_netcdf | netherlands_raw_csv | openrainer_tar
dataset_path=
export_cml_metadata_json=False
cml_metadata_json_filename=cml_metadata.json
export_rain_event_summary_csv=False
rain_event_summary_filename=rain_event_summary.csv
auto_adjust_region=True ; auto-fit [limits] to custom dataset extent for non-influx sources
region_padding_deg=0.3
netherlands_file_glob=NEC_*.csv.gz
netherlands_signal_stat=rxmin ; rxmin | rxmax | mid
netherlands_polarization=V
netherlands_mask_errored=True
openrainer_cml_archive=CML.tar
openrainer_reference_source=radadj ; radadj | radrain | radref | aws | none
openrainer_export_reference_pngs=False
openrainer_reference_manifest_filename=openrainer_reference_manifest.json

[wet_dry]
is_mlp_enabled=False
cnn_model=ours
cnn_model_name=cnn_v22_ds_cz_param_2025-05-15_22;01
rolling_hours=1.0
rolling_values=10
wet_dry_deviation=0.8
is_window_centered=False
baseline_samples=5
ignore_dry_links=False 

[waa]
waa_method=pastorek
waa_schleiss_val=2.2
waa_schleiss_tau=15

[interp]
interp_res=0.025
idw_power=2
idw_near=12
idw_dist=0.4
use_mercator=True
grid_nx=598
grid_ny=378
grid_step_m=1000.0
idw_dist_m=20000.0

[raingrids]
min_rain_value=0.1
overall_intensity_ref=20 
overall_intensity_method=coverage ; mean / p90 / p95 or coverage_strength / coverage
overall_intensity_threshold=0
overall_intensity_min_if_any_link=0.001
overall_intensity_coverage_gamma=0.3 ; sensitivity tuning (lower = more sensitive near 0)
overall_intensity_strength_gamma=1.0

[temp]
is_temp_filtered=False
is_temp_compensated=False
correlation_threshold=0.7

[limits]
x_min=11.267
x_max=19.624
y_min=48.047
y_max=51.458

[rendering]
is_crop_enabled=True
geojson_file=czechia.json
