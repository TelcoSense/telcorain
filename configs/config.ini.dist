# global settings
[time]
step=10
output_step=10
start=2024-09-19T03:30:00
end=2024-09-19T12:30:00

[setting]
repetition_interval=600
sleep_interval=30
output_json_info=True
write_influx_intensities=False
dry_as_nan=False

[logging]
init_level=INFO

[directories]
logs=./logs
outputs=outputs
outputs_web=outputs_web
outputs_raw=outputs_raw
outputs_json=outputs_json
outputs_sum=outputs_sum
outputs_sum_json=outputs_sum_json
clean_web=False
clean_raw=False
save_web=True
save_raw=False

[hour_sum]
enabled=False
window_minutes=60
write_influx_sum=False

# database settings
[influx2]
url=
org=
token=
timeout=50000
verify_ssl=False
bucket_influx_data=realtime_cbl
bucket_out_cml=telcorain_output

[mariadb]
address=
port=
user=
pass=
timeout=10000
db_metadata=cml_metadata
db_output=telcorain_output
exclude_cmls_path=cml_info/invalid_cmls.csv

# computation settings
[cml]
min_length=0.5
max_length=100
exclude_cmls=True

[realtime]
realtime_timewindow=1d
retention_window=7d
metadata_refresh_interval_runs=60 ; set 0 to disable periodic MariaDB metadata reload

[historic]
compensate_historic=True

[data_source]
mode=influx ; influx | pycomlink_example | pycomlink_netcdf | netherlands_raw_csv | openrainer_tar
dataset_path=
export_cml_metadata_json=False
cml_metadata_json_filename=cml_metadata.json
export_rain_event_summary_csv=False
rain_event_summary_filename=rain_event_summary.csv
auto_adjust_region=True ; auto-fit [limits] to custom dataset extent for non-influx sources
region_padding_deg=0.3
netherlands_file_glob=NEC_*.csv.gz
netherlands_signal_stat=rxmin ; rxmin | rxmax | mid
netherlands_polarization=V
netherlands_mask_errored=True
openrainer_cml_archive=CML.tar
openrainer_reference_source=radadj ; radadj | radrain | radref | aws | none
openrainer_export_reference_pngs=False
openrainer_reference_manifest_filename=openrainer_reference_manifest.json

[wet_dry]
is_mlp_enabled=False
cnn_model=ours
cnn_model_name=cnn_v22_ds_cz_param_2025-05-15_22;01
rolling_hours=1.0
rolling_values=10
wet_dry_deviation=0.8
is_window_centered=False
baseline_samples=5
ignore_dry_links=False 

[waa]
waa_method=pastorek
waa_schleiss_val=2.2
waa_schleiss_tau=15

[interp]
interp_res=0.025
idw_power=2
idw_near=12
idw_dist=0.4
use_mercator=True
grid_nx=598
grid_ny=378
grid_step_m=1000.0
idw_dist_m=20000.0

[raingrids]
min_rain_value=0.1
overall_intensity_ref=20 
overall_intensity_method=coverage ; mean / p90 / p95 or coverage_strength / coverage
overall_intensity_threshold=0
overall_intensity_min_if_any_link=0.001
overall_intensity_coverage_gamma=0.3 ; sensitivity tuning (lower = more sensitive near 0)
overall_intensity_strength_gamma=1.0

[temp]
is_temp_filtered=False
is_temp_compensated=False
correlation_threshold=0.7

[limits]
x_min=11.267
x_max=19.624
y_min=48.047
y_max=51.458

[rendering]
is_crop_enabled=True
geojson_file=czechia.json
